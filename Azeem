<!DOCTYPE html>
<html lang="ur">
<head>
<meta charset="UTF-8">
<title>Kids Cartoon Urdu Story</title>

<style>
body {
  margin: 0;
  font-family: "Comic Sans MS";
  background: skyblue;
}

#scene {
  width: 100%;
  height: 100vh;
  background: linear-gradient(skyblue, lightgreen);
  position: relative;
  overflow: hidden;
  text-align: center;
}

.turtle {
  font-size: 70px;
  position: absolute;
  left: 10px;
  bottom: 80px;
  animation: move 20s linear infinite;
}

.rabbit {
  font-size: 70px;
  position: absolute;
  right: 30px;
  bottom: 80px;
}

#text {
  position: absolute;
  bottom: 10px;
  width: 100%;
  background: rgba(255,255,255,0.85);
  font-size: 22px;
  padding: 10px;
}

@keyframes move {
  from { left: 0; }
  to { left: 70%; }
}

button {
  font-size: 18px;
  padding: 8px 16px;
  margin: 5px;
}
</style>
</head>

<body>

<div id="scene">
  <div class="turtle">🐢</div>
  <div class="rabbit">🐇</div>
  <div id="text">کہانی شروع ہو رہی ہے</div>
</div>

<div style="text-align:center;">
  <button onclick="startStory()">▶ کہانی شروع کریں</button>
  <button onclick="startMusic()">🎵 میوزک آن</button>
  <button onclick="stopMusic()">🔇 میوزک آف</button>
</div>

<script>
/* ===== STORY TEXT ===== */
const story = [
  "حصہ ایک: ایک خوش مزاج کچھوا دریا کے پاس رہتا تھا۔",
  "جانور اس کا مذاق اڑاتے تھے مگر وہ صبر کرتا تھا۔",
  "حصہ دو: ایک تیز خرگوش نے دوڑ کا چیلنج دیا۔",
  "خرگوش تیز دوڑا اور سو گیا۔",
  "کچھوا آہستہ آہستہ چلتا رہا۔",
  "حصہ تین: کچھوا جیت گیا۔",
  "سب جانور خوش ہو گئے۔",
  "سبق: آہستہ اور مستقل مزاجی کامیابی لاتی ہے۔"
];

let index = 0;
const textDiv = document.getElementById("text");

/* ===== URDU VOICE ===== */
function speakUrdu(text) {
  const msg = new SpeechSynthesisUtterance(text);
  msg.lang = "ur-PK";
  msg.rate = 0.9;
  speechSynthesis.speak(msg);
}

/* ===== BACKGROUND MUSIC (BUILT-IN) ===== */
let audioCtx, oscillator, gainNode;

function startMusic() {
  audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  oscillator = audioCtx.createOscillator();
  gainNode = audioCtx.createGain();

  oscillator.type = "sine";     // soft kids music
  oscillator.frequency.setValueAtTime(220, audioCtx.currentTime);

  gainNode.gain.value = 0.05;   // low volume

  oscillator.connect(gainNode);
  gainNode.connect(audioCtx.destination);
  oscillator.start();
}

function stopMusic() {
  if (oscillator) {
    oscillator.stop();
    oscillator = null;
  }
}

/* ===== START STORY ===== */
function startStory() {
  index = 0;
  startMusic();

  const interval = setInterval(() => {
    if (index >= story.length) {
      stopMusic();
      clearInterval(interval);
      return;
    }
    textDiv.innerText = story[index];
    speakUrdu(story[index]);
    index++;
  }, 7000); // ~1 minute
}
</script>

</body>
</html>
